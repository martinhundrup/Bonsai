{
  "name": "bonsai-json",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "start": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "test": "node --test tests/core.test.mjs tests/camera.test.mjs tests/graph.test.mjs tests/collisions.test.mjs tests/workspace.test.mjs",
    "cf:login": "wrangler login --use-keyring",
    "cf:whoami": "wrangler whoami",
    "cf:prepare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "cf:preview": "npm run cf:prepare && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "cf:check": "npm run cf:prepare && wrangler deploy --dry-run",
    "deploy": "npm run cf:prepare && wrangler deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  }
}
