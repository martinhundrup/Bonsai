{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bonsai-json",
  "account_id": "68555cfc43ca5a5579ad49a3e7060711",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.cloudflare/assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "martinhundrup.com/bonsai",
      "zone_name": "martinhundrup.com"
    },
    {
      "pattern": "martinhundrup.com/bonsai/*",
      "zone_name": "martinhundrup.com"
    }
  ]
}
